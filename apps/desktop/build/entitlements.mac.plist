<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements of the ad-hoc signed ALP.app (docs/alp/desktop.md §6).
  allow-jit: V8's JIT. disable-library-validation: the ad-hoc signed app loads the Electron
  frameworks, whose signature carries another Team ID; without it hardened runtime refuses them.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
