# Primary TLS path (docs/alp/remote-gateway.md §7): Caddy terminates TLS with an automatic
# certificate and forwards to the gateway on loopback. Caddy keeps the Host header and sets
# X-Forwarded-For and X-Forwarded-Proto; the gateway trusts them only from 127.0.0.1/::1
# ("trustProxy" in gateway.json) and refuses requests that did not arrive over HTTPS.
alp.example.com {
	# Only the gateway's routes; nothing else on this name.
	@gateway path /v1/tickets /v1/ws /healthz /readyz
	handle @gateway {
		# Caddy proxies WebSocket upgrades as they are, without a read timeout by default.
		reverse_proxy 127.0.0.1:7434
	}
	handle {
		respond 404
	}
	# Never log request headers here: Sec-WebSocket-Protocol carries the one-time ticket.
	log {
		output stderr
		format filter {
			request>headers delete
		}
	}
}
