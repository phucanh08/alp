{
  // The scripts are TypeScript that Node (>= 22.18, the dev/CI floor) runs directly by stripping types:
  // relative imports name the .ts file, type-only imports say so (verbatimModuleSyntax), and only erasable
  // syntax is allowed. This only type-checks them strictly; nothing is emitted.
  // Run: pnpm exec tsc -p scripts/tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    // Workspace imports (@anhlp/*) resolve to their TypeScript sources: no build needed to check.
    "customConditions": ["alp-source"],
    // ../apps/web/scripts/*.mjs stay JavaScript for now and carry // @ts-check: check them here too.
    "allowJs": true,
    "checkJs": true,
    // binary-smoke.ts imports ../packages/cli/dist/commands/update/self-update.js (built at run time); this lets the
    // checker read packages/cli/src/commands/update/self-update.ts in its place, without a build.
    "rootDirs": ["../packages/cli/src", "../packages/cli/dist"]
  },
  // browser-page-globals.d.ts: types only, for the page callbacks of client-sdk-smoke.ts.
  "include": ["*.ts", "../apps/web/scripts/*.mjs"]
}
