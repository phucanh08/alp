+  // ALP: one folder's children at a time; a filter is a prefix the host matches, a path is completed.
+  const browseQuery = useFetchQuery({
+    queryKey: ["add-project-flow-browse", hostId, browsePath, debouncedQuery],
+    queryFn: async () => {
+      if (!client || browsePath === null) return EMPTY_LISTING;
+      let base: string | null = browsePath;
+      if (browsePath === "~" || browsePath.startsWith("~/")) {
+        // The host's home is the one folder "~" completes to; a project needs its full path.
+        const home = await client.getDirectorySuggestions({
+          query: "~",
+          includeDirectories: true,
+          includeFiles: false,
+          limit: 1,
+        });
+        const homePath = home.entries?.find((entry) => entry.kind === "directory")?.path ?? null;
+        base =
+          homePath && browsePath !== "~"
+            ? joinDirectoryPath(homePath, browsePath.slice(2))
+            : homePath;
+      }
+      const typed = debouncedQuery.trim();
+      const asPath = typed.startsWith("/") || typed.startsWith("~");
+      if (!base && !asPath) return { ...EMPTY_LISTING, path: browsePath, query: debouncedQuery };
+      const payload = await client.getDirectorySuggestions({
+        query: asPath ? typed : childDirectoryQuery(base ?? "/", typed),
+        includeDirectories: true,
+        includeFiles: false,
+        limit: 100,
+      });
+      return {
+        path: browsePath,
+        query: debouncedQuery,
+        base,
+        paths:
