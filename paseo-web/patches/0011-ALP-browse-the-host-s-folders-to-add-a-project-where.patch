+
+/** ALP: the folder browser's rows: add this folder, a new folder in it, its parent, then its folders. */
+function buildBrowseRows(input: BrowseRowsInput): FlowRowOption[] {
+  const { base, paths } = input.listing;
+  const typedPath = /^[/~]/.test(input.query.trim());
+  const folders = paths.map<FlowRowOption>((path) => ({
+    id: path,
+    title: pathBaseName(path),
+    subtitle: null,
+    icon: Folder,
+    testID: pathTestId(path),
+    select: () => input.open(path),
+  }));
+  const typed = input.query.trim();
+  // A typed folder (ending in "/") is the first choice, so Enter goes there rather than into its first child.
+  if (typedPath && /[/\\]$/.test(typed) && typed.length > 1) {
+    const folder = typed.replace(/[/\\]+$/, "");
+    return [
+      {
+        id: `browse-go:${folder}`,
+        title: shortenPath(folder),
+        subtitle: "Go to this folder",
+        icon: FolderOpen,
+        testID: "add-project-flow-browse-go",
+        select: () => input.open(folder),
+      },
+      ...folders,
+    ];
+  }
+  if (typed || !base) return folders;
+  const here: FlowRowOption[] = [
+    {
+      id: "browse-add",
+      title: "Add this folder",
+      subtitle: shortenPath(base),
+      icon: FolderOpen,
+      testID: "add-project-flow-browse-add",
+      select: () => input.add(base),
+    },
+  ];
+  if (input.canCreateDirectory) {
+    here.push({
+      id: "browse-new",
+      title: "New folder here",
+      subtitle: `Create a folder in ${pathBaseName(base) || base}`,
+      icon: FolderPlus,
+      testID: "add-project-flow-browse-new",
+      select: () => input.create(base),
+    });
+  }
+  const parent = parentDirectory(base);
+  if (parent && parent !== base) {
+    here.push({
+      id: "browse-up",
+      title: "..",
+      subtitle: shortenPath(parent),
+      icon: FolderUp,
+      testID: "add-project-flow-browse-up",
+      select: input.up,
+    });
+  }
+  return [...here, ...folders];
+}
