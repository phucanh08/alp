+describe("ALP folder browser", () => {
+  it("offers Browse folders where Finder is not there", () => {
+    const ids = (host: AddProjectHost) => buildAddProjectMethods(host).map((method) => method.id);
+    expect(ids(HOST)).not.toContain("browse-folders");
+    expect(ids({ ...HOST, canBrowse: false })).toEqual([
+      "directory-search",
+      "browse-folders",
+      "github",
+      "new-directory",
+    ]);
+  });
+
+  it("moves through folders in one page, so Back leaves the browser", () => {
+    const opened = openDirectoryBrowsePage(
+      chooseAddProjectHost(
+        openAddProjectFlow({ hosts: [HOST, { ...HOST, serverId: "host-2" }] }),
+        "host-1",
+      ),
+      "host-1",
+      "~",
+    );
+    const filtered = setAddProjectPageInput(opened, "Stu");
+    const moved = browseAddProjectDirectory(filtered, "/Users/me/StudioProjects");
+    expect(currentAddProjectPage(moved)).toMatchObject({
+      kind: "directory-browse",
+      path: "/Users/me/StudioProjects",
+      query: "",
+      activeIndex: 0,
+    });
+    expect(moved.pages).toHaveLength(opened.pages.length);
+    expect(currentAddProjectPage(backAddProjectPage(moved)!).kind).toBe("method");
+  });
+
+  it("asks the host for a folder's children by prefix", () => {
+    expect(childDirectoryQuery("/Users/me", "")).toBe("/Users/me/");
+    expect(childDirectoryQuery("/Users/me", "Stu")).toBe("/Users/me/Stu");
+    expect(childDirectoryQuery("/", "Us")).toBe("/Us");
+  });
+});
