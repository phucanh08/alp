diff --git a/packages/app/src/data/alp-provider-surfaces.ts b/packages/app/src/data/alp-provider-surfaces.ts
new file mode 100644
--- /dev/null
+++ b/packages/app/src/data/alp-provider-surfaces.ts
@@ -0,0 +1,7 @@
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+
+/** ALP is the team launcher; Settings lists the runtimes its teams use. */
+export function selectAlpProviderEntries(entries: ProviderSnapshotEntry[] | undefined, settings: boolean) {
+  if (!entries?.some((entry) => entry.provider === "alp")) return entries;
+  return entries.filter((entry) => settings ? entry.provider !== "alp" : entry.provider === "alp");
+}
diff --git a/packages/app/src/data/alp-provider-surfaces.test.ts b/packages/app/src/data/alp-provider-surfaces.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/app/src/data/alp-provider-surfaces.test.ts
@@ -0,0 +1,17 @@
+import { describe, expect, it } from "vitest";
+import type { ProviderSnapshotEntry } from "@getpaseo/protocol/agent-types";
+import { selectAlpProviderEntries } from "./alp-provider-surfaces";
+
+describe("ALP provider surfaces", () => {
+  const entries = ["alp", "claude", "codex", "opencode", "gemini"].map(provider => ({ provider, status: "ready", models: [] })) as ProviderSnapshotEntry[];
+  it("Settings shows native and ACP providers, excluding the core", () => {
+    expect(selectAlpProviderEntries(entries, true)?.map(entry => entry.provider)).toEqual(["claude", "codex", "opencode", "gemini"]);
+  });
+  it("agent launchers keep the internal team entry", () => {
+    expect(selectAlpProviderEntries(entries, false)?.map(entry => entry.provider)).toEqual(["alp"]);
+  });
+  it("leaves regular Paseo hosts unchanged", () => {
+    const regular = entries.slice(1);
+    expect(selectAlpProviderEntries(regular, false)).toBe(regular);
+  });
+});
