+import { useCallback, useEffect, useMemo, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { Text, View, type TextStyle } from "react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import { SquareTerminal } from "lucide-react-native";
+import {
+  AdaptiveModalSheet,
+  AdaptiveTextInput,
+  type SheetHeader,
+} from "@/components/adaptive-modal-sheet";
+import { Button } from "@/components/ui/button";
+import { isWeb } from "@/constants/platform";
+import { useDaemonConfig } from "@/hooks/use-daemon-config";
+import { useProvidersSnapshot } from "@/hooks/use-providers-snapshot";
+import type { Theme } from "@/styles/theme";
+import {
+  buildCustomAcpProviderPatch,
+  type CustomAcpProviderError,
+} from "./custom-acp-provider-form";
+
+/**
+ * ALP: Add provider → Custom ACP agent, for an agent the catalog does not list: a name, the
+ * command line that starts it and its environment.
+ */
+
+/** Names the host keeps for its own runtimes. */
+const RESERVED_IDS = ["alp", "codex", "claude", "acp"];
+const SNAP_POINTS = ["60%"];
+
+const ThemedSquareTerminal = withUnistyles(SquareTerminal);
+const foregroundColorMapping = (theme: Theme) => ({ color: theme.colors.foreground });
+// outlineStyle is web-only.
+const webInput = isWeb ? ({ outlineStyle: "none" } as unknown as TextStyle) : null;
+
+interface CustomAcpProviderProps {
+  serverId: string;
+}
+
+export function CustomAcpProvider({ serverId }: CustomAcpProviderProps) {
+  const { t } = useTranslation();
+  const [open, setOpen] = useState(false);
+  const handleOpen = useCallback(() => setOpen(true), []);
+  const handleClose = useCallback(() => setOpen(false), []);
+
+  return (
+    <View style={styles.row} testID="custom-acp-provider">
+      <View style={styles.iconFrame}>
+        <ThemedSquareTerminal size={20} uniProps={foregroundColorMapping} />
+      </View>
+      <View style={styles.textColumn}>
+        <Text style={styles.name} numberOfLines={1}>
+          {t("providerCatalog.custom.title")}
+        </Text>
+        <Text style={styles.description} numberOfLines={2}>
+          {t("providerCatalog.custom.description")}
+        </Text>
+      </View>
+      <Button
+        size="sm"
+        variant="secondary"
+        onPress={handleOpen}
+        style={styles.actionButton}
+        testID="custom-acp-provider-open"
+      >
+        {t("providerCatalog.actions.add")}
+      </Button>
+      <CustomAcpProviderSheet serverId={serverId} visible={open} onClose={handleClose} />
+    </View>
+  );
+}
+
+function errorKey(error: CustomAcpProviderError): string {
+  return `providerCatalog.custom.errors.${error}`;
+}
+
+function CustomAcpProviderSheet({
+  serverId,
+  visible,
+  onClose,
+}: {
+  serverId: string;
+  visible: boolean;
+  onClose: () => void;
+}) {
+  const { t } = useTranslation();
+  const { patchConfig } = useDaemonConfig(serverId);
+  const { entries, refresh } = useProvidersSnapshot(serverId, { includeAcpAgents: true });
+  const [name, setName] = useState("");
+  const [command, setCommand] = useState("");
+  const [env, setEnv] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [saving, setSaving] = useState(false);
+
+  // A change to any field clears the last error.
+  const setNameClearing = useCallback((value: string) => {
+    setName(value);
+    setError(null);
+  }, []);
+  const setCommandClearing = useCallback((value: string) => {
+    setCommand(value);
+    setError(null);
+  }, []);
+  const setEnvClearing = useCallback((value: string) => {
+    setEnv(value);
+    setError(null);
+  }, []);
+
+  const takenIds = useMemo(
+    () => new Set([...RESERVED_IDS, ...(entries ?? []).map((entry) => entry.provider)]),
+    [entries],
+  );
+
+  useEffect(() => {
+    if (!visible) {
+      setName("");
+      setCommand("");
+      setEnv("");
+      setError(null);
+    }
+  }, [visible]);
+
+  const handleAdd = useCallback(() => {
+    const result = buildCustomAcpProviderPatch({ name, command, env }, takenIds);
+    if (!result.ok) {
+      setError(t(errorKey(result.error), { name: name.trim() }));
+      return;
+    }
+    setError(null);
+    setSaving(true);
+    void patchConfig(result.patch)
+      .then(() => refresh([result.id]))
+      .then(() => onClose())
+      .catch((err) => setError(err instanceof Error ? err.message : String(err)))
+      .finally(() => setSaving(false));
+  }, [command, env, name, onClose, patchConfig, refresh, t, takenIds]);
+
+  const header = useMemo<SheetHeader>(() => ({ title: t("providerCatalog.custom.title") }), [t]);
+
+  return (
+    <AdaptiveModalSheet
+      header={header}
+      visible={visible}
+      onClose={onClose}
+      desktopMaxWidth={480}
+      snapPoints={SNAP_POINTS}
+      testID="custom-acp-provider-sheet"
+    >
+      <View style={styles.form}>
+        <View style={styles.field}>
+          <Text style={styles.label}>{t("providerCatalog.custom.name")}</Text>
+          <AdaptiveTextInput
+            initialValue={name}
+            resetKey={`custom-acp-name-${visible}`}
+            onChangeText={setNameClearing}
+            placeholder={t("providerCatalog.custom.namePlaceholder")}
+            autoCorrect={false}
+            style={[styles.input, webInput]}
+            testID="custom-acp-provider-name"
+          />
+        </View>
+        <View style={styles.field}>
+          <Text style={styles.label}>{t("providerCatalog.custom.command")}</Text>
+          <AdaptiveTextInput
+            initialValue={command}
+            resetKey={`custom-acp-command-${visible}`}
+            onChangeText={setCommandClearing}
+            placeholder={t("providerCatalog.custom.commandPlaceholder")}
+            autoCapitalize="none"
+            autoCorrect={false}
+            style={[styles.input, webInput, styles.mono]}
+            testID="custom-acp-provider-command"
+          />
+          <Text style={styles.hint}>{t("providerCatalog.custom.commandHint")}</Text>
+        </View>
+        <View style={styles.field}>
+          <Text style={styles.label}>{t("providerCatalog.custom.env")}</Text>
+          <AdaptiveTextInput
+            initialValue={env}
+            resetKey={`custom-acp-env-${visible}`}
+            onChangeText={setEnvClearing}
+            placeholder={t("providerCatalog.custom.envPlaceholder")}
+            autoCapitalize="none"
+            autoCorrect={false}
+            multiline
+            numberOfLines={3}
+            style={[styles.input, webInput, styles.mono, styles.multiline]}
+            testID="custom-acp-provider-env"
+          />
+        </View>
+        {error ? (
+          <Text style={styles.error} testID="custom-acp-provider-error">
+            {error}
+          </Text>
+        ) : null}
+        <View style={styles.actions}>
+          <Button variant="secondary" size="sm" onPress={onClose} disabled={saving}>
+            {t("common.actions.cancel")}
+          </Button>
+          <Button
+            variant="default"
+            size="sm"
+            onPress={handleAdd}
+            disabled={saving || !name.trim() || !command.trim()}
+            loading={saving}
+            testID="custom-acp-provider-add"
+          >
+            {saving ? t("providerCatalog.actions.adding") : t("providerCatalog.actions.add")}
+          </Button>
+        </View>
+      </View>
+    </AdaptiveModalSheet>
+  );
+}
+
+const styles = StyleSheet.create((theme) => ({
+  row: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[3],
+    padding: theme.spacing[3],
+    marginBottom: theme.spacing[3],
+    borderRadius: theme.borderRadius.lg,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+  },
+  iconFrame: {
+    width: 36,
+    height: 36,
+    borderRadius: theme.borderRadius.md,
+    backgroundColor: theme.colors.surface2,
+    alignItems: "center",
+    justifyContent: "center",
+    flexShrink: 0,
+  },
+  textColumn: {
+    flex: 1,
+    minWidth: 0,
+    gap: theme.spacing[1],
+  },
+  name: {
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.base,
+    fontWeight: theme.fontWeight.medium,
+  },
+  description: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+  },
+  actionButton: {
+    width: 92,
+    flexShrink: 0,
+  },
+  form: {
+    gap: theme.spacing[4],
+  },
+  field: {
+    gap: theme.spacing[2],
+  },
+  label: {
+    fontSize: theme.fontSize.base,
+    fontWeight: theme.fontWeight.medium,
+    color: theme.colors.foreground,
+  },
+  input: {
+    backgroundColor: theme.colors.surface2,
+    borderRadius: theme.borderRadius.lg,
+    paddingHorizontal: theme.spacing[4],
+    paddingVertical: theme.spacing[3],
+    color: theme.colors.foreground,
+    borderWidth: 1,
+    borderColor: theme.colors.border,
+    fontSize: theme.fontSize.base,
+  },
+  mono: {
+    fontFamily: theme.fontFamily.mono,
+    fontSize: theme.fontSize.code,
+  },
+  multiline: {
+    minHeight: 72,
+    textAlignVertical: "top",
+  },
+  hint: {
+    color: theme.colors.foregroundMuted,
+    fontSize: theme.fontSize.sm,
+  },
+  error: {
+    fontSize: theme.fontSize.sm,
+    color: theme.colors.destructive,
+  },
+  actions: {
+    flexDirection: "row",
+    justifyContent: "flex-end",
+    gap: theme.spacing[2],
+  },
+}));
