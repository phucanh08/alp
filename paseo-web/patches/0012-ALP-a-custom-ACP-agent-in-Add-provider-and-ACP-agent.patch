diff --git a/packages/app/src/components/custom-acp-provider-form.test.ts b/packages/app/src/components/custom-acp-provider-form.test.ts
new file mode 100644
index 0000000..48c1d6e
--- /dev/null
+++ b/packages/app/src/components/custom-acp-provider-form.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildCustomAcpProviderPatch,
+  customAcpProviderId,
+  parseCommandLine,
+  parseEnvLines,
+} from "./custom-acp-provider-form";
+
+describe("ALP custom ACP agent", () => {
+  it("names the provider as the host accepts", () => {
+    expect(customAcpProviderId("My Agent 2")).toBe("my-agent-2");
+    expect(customAcpProviderId("  42 Gemini!  ")).toBe("gemini");
+    expect(customAcpProviderId("123")).toBe("");
+  });
+
+  it("splits a command line into the program and its arguments", () => {
+    expect(parseCommandLine("gemini --experimental-acp")).toEqual(["gemini", "--experimental-acp"]);
+    expect(parseCommandLine(`npx -y "@scope/agent acp" --flag='a b' x\\ y`)).toEqual([
+      "npx",
+      "-y",
+      "@scope/agent acp",
+      "--flag=a b",
+      "x y",
+    ]);
+    expect(parseCommandLine(`run ""`)).toEqual(["run", ""]);
+    expect(parseCommandLine(`run "open`)).toBeNull();
+  });
+
+  it("reads KEY=value lines", () => {
+    expect(parseEnvLines("A=1\n\n  B_2=x=y  \n")).toEqual({ A: "1", B_2: "x=y" });
+    expect(parseEnvLines("")).toEqual({});
+    expect(parseEnvLines("not a pair")).toBeNull();
+  });
+
+  it("builds the config change the host applies, or says what is missing", () => {
+    const taken = new Set(["alp", "gemini"]);
+    expect(
+      buildCustomAcpProviderPatch(
+        { name: "My Agent", command: "my-agent --acp", env: "TOKEN=abc" },
+        taken,
+      ),
+    ).toEqual({
+      ok: true,
+      id: "my-agent",
+      patch: {
+        providers: {
+          "my-agent": {
+            extends: "acp",
+            label: "My Agent",
+            command: ["my-agent", "--acp"],
+            env: { TOKEN: "abc" },
+          },
+        },
+      },
+    });
+    const fails = (name: string, command: string, env = "") =>
+      buildCustomAcpProviderPatch({ name, command, env }, taken);
+    expect(fails("!!", "x")).toEqual({ ok: false, error: "name" });
+    expect(fails("Gemini", "x")).toEqual({ ok: false, error: "exists" });
+    expect(fails("New", "  ")).toEqual({ ok: false, error: "command" });
+    expect(fails("New", "x", "oops")).toEqual({ ok: false, error: "env" });
+  });
+});
diff --git a/packages/app/src/components/custom-acp-provider-form.ts b/packages/app/src/components/custom-acp-provider-form.ts
new file mode 100644
index 0000000..79ff72e
--- /dev/null
+++ b/packages/app/src/components/custom-acp-provider-form.ts
@@ -0,0 +1,97 @@
+import type { MutableDaemonConfigPatch } from "@getpaseo/protocol/messages";
+
+/**
+ * ALP: a custom ACP agent from three fields: a name, the command line that starts it and its
+ * environment. The host keeps it as an ACP provider (`extends: "acp"`), as one from the catalog.
+ */
+
+export interface CustomAcpProviderInput {
+  name: string;
+  command: string;
+  env: string;
+}
+
+export type CustomAcpProviderError = "name" | "command" | "env" | "exists";
+
+export type CustomAcpProviderResult =
+  | { ok: true; id: string; patch: MutableDaemonConfigPatch }
+  | { ok: false; error: CustomAcpProviderError };
+
+/** The provider id for a name: lowercase letters, digits and "-", starting with a letter. */
+export function customAcpProviderId(name: string): string {
+  return name
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^[^a-z]+/, "")
+    .replace(/-+$/, "");
+}
+
+/** Splits a command line as a shell would split plain words and quoted strings. */
+export function parseCommandLine(line: string): string[] | null {
+  const words: string[] = [];
+  let word = "";
+  let started = false;
+  let quote: '"' | "'" | null = null;
+  for (let index = 0; index < line.length; index += 1) {
+    const char = line[index]!;
+    if (quote) {
+      if (char === quote) quote = null;
+      else if (char === "\\" && quote === '"' && index + 1 < line.length) word += line[++index];
+      else word += char;
+      continue;
+    }
+    if (char === '"' || char === "'") {
+      quote = char;
+      started = true;
+    } else if (char === "\\" && index + 1 < line.length) {
+      word += line[++index];
+      started = true;
+    } else if (/\s/.test(char)) {
+      if (started) words.push(word);
+      word = "";
+      started = false;
+    } else {
+      word += char;
+      started = true;
+    }
+  }
+  if (quote) return null;
+  if (started) words.push(word);
+  return words;
+}
+
+/** KEY=value lines; blank lines are skipped. */
+export function parseEnvLines(text: string): Record<string, string> | null {
+  const env: Record<string, string> = {};
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.trim();
+    if (!line) continue;
+    const match = line.match(/^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/);
+    if (!match) return null;
+    env[match[1]!] = match[2]!;
+  }
+  return env;
+}
+
+export function buildCustomAcpProviderPatch(
+  input: CustomAcpProviderInput,
+  takenIds: ReadonlySet<string>,
+): CustomAcpProviderResult {
+  const id = customAcpProviderId(input.name);
+  if (!id) return { ok: false, error: "name" };
+  if (takenIds.has(id)) return { ok: false, error: "exists" };
+  const command = parseCommandLine(input.command.trim());
+  if (!command || command.length === 0) return { ok: false, error: "command" };
+  const env = parseEnvLines(input.env);
+  if (!env) return { ok: false, error: "env" };
+  return {
+    ok: true,
+    id,
+    patch: {
+      providers: {
+        [id]: { extends: "acp", label: input.name.trim(), command, env },
+      },
+    },
+  };
+}
diff --git a/packages/app/src/components/custom-acp-provider.tsx b/packages/app/src/components/custom-acp-provider.tsx
