{
  "name": "@anhlp/alp-daemon",
  "version": "0.0.1-beta.14",
  "type": "module",
  "description": "ALP daemon module",
  "files": [
    "src",
    "dist",
    "NOTICE",
    "native/terminal-owner.c",
    "native/README.md",
    "native/prebuilt"
  ],
  "exports": {
    "./index": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    ".": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attachments": {
      "alp-source": {
        "types": "./src/attachments/attachments.ts",
        "default": "./src/attachments/attachments.ts"
      },
      "types": "./dist/attachments/attachments.d.ts",
      "default": "./dist/attachments/attachments.js"
    },
    "./terminals": {
      "alp-source": {
        "types": "./src/terminals/terminals.ts",
        "default": "./src/terminals/terminals.ts"
      },
      "types": "./dist/terminals/terminals.d.ts",
      "default": "./dist/terminals/terminals.js"
    },
    "./conversation": {
      "alp-source": {
        "types": "./src/sessions/conversation.ts",
