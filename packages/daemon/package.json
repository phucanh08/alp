  "dependencies": {
    "@anhlp/alp-core": "0.0.1-beta.14",
    "@anhlp/alp-runtime": "0.0.1-beta.14",
    "@anhlp/alp-client": "0.0.1-beta.14",
    "@anhlp/alp-protocol": "0.0.1-beta.14",
    "@anthropic-ai/sdk": "^0.131.0",
    "ws": "^8.22.0",
    "zod": "4.6.7",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@xterm/headless": "6.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-workspace.ts daemon",
    "test": "node ../../scripts/test-package.ts daemon",
    "prepack": "npm run build"
  },
  "publishConfig": {
