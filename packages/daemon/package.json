{
  "name": "@anhlp/alp-daemon",
  "version": "0.0.0-beta.1",
  "type": "module",
  "description": "ALP daemon module",
  "files": [
    "src",
    "dist",
    "NOTICE"
  ],
  "exports": {
    "./index": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    ".": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lock": {
      "alp-source": {
        "types": "./src/lock.ts",
        "default": "./src/lock.ts"
      },
      "types": "./dist/lock.d.ts",
      "default": "./dist/lock.js"
    },
    "./main": {
      "alp-source": {
        "types": "./src/main.ts",
        "default": "./src/main.ts"
      },
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./server": {
      "alp-source": {
        "types": "./src/server.ts",
        "default": "./src/server.ts"
      },
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./store": {
      "alp-source": {
        "types": "./src/store.ts",
        "default": "./src/store.ts"
      },
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anhlp/alp-core": "0.0.0-beta.1",
    "@anhlp/alp-runtime": "0.0.0-beta.1",
    "@anhlp/alp-client": "0.0.0-beta.1",
    "@anhlp/alp-protocol": "0.0.0-beta.1",
    "@anthropic-ai/sdk": "^0.131.0",
    "ws": "^8.22.0",
    "zod": "4.4.3",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292"
  },
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs daemon",
    "test": "node ../../scripts/test-package.mjs daemon",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucanh08/alp.git",
    "directory": "packages/daemon"
  },
  "homepage": "https://github.com/phucanh08/alp/tree/main/packages/daemon#readme",
  "bugs": {
    "url": "https://github.com/phucanh08/alp/issues"
  }
}
