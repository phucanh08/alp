{
  "name": "@anhlp/alp-cli",
  "version": "0.0.1-beta.14",
  "type": "module",
  "description": "ALP cli module",
  "files": [
    "src",
    "!src/dashboard",
    "dist",
    "!dist/dashboard",
    "NOTICE"
  ],
  "exports": {
    "./acp/agent": {
      "alp-source": {
        "types": "./src/acp/agent.ts",
        "default": "./src/acp/agent.ts"
      },
      "types": "./dist/acp/agent.d.ts",
      "default": "./dist/acp/agent.js"
    },
    "./acp/main": {
      "alp-source": {
        "types": "./src/acp/main.ts",
        "default": "./src/acp/main.ts"
      },
      "types": "./dist/acp/main.d.ts",
      "default": "./dist/acp/main.js"
    },
    "./backup": {
      "alp-source": {
        "types": "./src/commands/backup.ts",
        "default": "./src/commands/backup.ts"
      },
      "types": "./dist/commands/backup.d.ts",
      "default": "./dist/commands/backup.js"
    },
    "./cli": {
      "alp-source": {
        "types": "./src/cli.ts",
        "default": "./src/cli.ts"
      },
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./daemon": {
      "alp-source": {
        "types": "./src/daemon.ts",
        "default": "./src/daemon.ts"
      },
      "types": "./dist/daemon.d.ts",
      "default": "./dist/daemon.js"
    },
    "./index": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    ".": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./interfaces": {
      "alp-source": {
        "types": "./src/interfaces.ts",
        "default": "./src/interfaces.ts"
      },
      "types": "./dist/interfaces.d.ts",
      "default": "./dist/interfaces.js"
    },
    "./library": {
      "alp-source": {
        "types": "./src/commands/library.ts",
        "default": "./src/commands/library.ts"
      },
      "types": "./dist/commands/library.d.ts",
      "default": "./dist/commands/library.js"
    },
    "./paths": {
      "alp-source": {
        "types": "./src/paths.ts",
        "default": "./src/paths.ts"
      },
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./projects": {
      "alp-source": {
        "types": "./src/commands/projects.ts",
        "default": "./src/commands/projects.ts"
      },
      "types": "./dist/commands/projects.d.ts",
      "default": "./dist/commands/projects.js"
    },
    "./sessions": {
      "alp-source": {
        "types": "./src/commands/sessions.ts",
        "default": "./src/commands/sessions.ts"
      },
      "types": "./dist/commands/sessions.d.ts",
      "default": "./dist/commands/sessions.js"
    },
    "./tasks": {
      "alp-source": {
        "types": "./src/commands/tasks.ts",
        "default": "./src/commands/tasks.ts"
      },
      "types": "./dist/commands/tasks.d.ts",
      "default": "./dist/commands/tasks.js"
    },
    "./usage": {
      "alp-source": {
        "types": "./src/commands/usage.ts",
        "default": "./src/commands/usage.ts"
      },
      "types": "./dist/commands/usage.d.ts",
      "default": "./dist/commands/usage.js"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anhlp/alp-core": "0.0.1-beta.14",
    "@anhlp/alp-client": "0.0.1-beta.14",
    "@anhlp/alp-protocol": "0.0.1-beta.14",
    "smol-toml": "1.9.0",
    "@agentclientprotocol/sdk": "1.7.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292"
  },
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs cli",
    "test": "node ../../scripts/test-package.mjs cli",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucanh08/alp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/phucanh08/alp/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/phucanh08/alp/issues"
  },
  "bin": {
    "alp": "dist/cli.js"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@anhlp/alp-gateway": "0.0.1-beta.14"
  }
}
