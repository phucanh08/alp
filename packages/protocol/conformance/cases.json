          "expect": {
            "id": 3,
            "error": {
              "code": -32602
            }
          }
        },
        {
          "probe": "conformance.shape"
        }
      ]
    },
    {
      "id": "errors.invalid-params",
      "profile": "errors",
      "description": "Params against a method's schema fail with -32602 invalid_params naming the issues; null is not the same as absent.",
      "hello": true,
      "steps": [
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "session.get",
            "params": {
              "sessionId": 5
            }
          },
          "expect": {
            "id": 1,
            "error": {
              "code": -32602,
              "data": {
                "reason": "invalid_params",
                "issues": {
                  "$type": "array"
                }
              }
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 2,
            "method": "session.get",
            "params": {}
          },
          "expect": {
            "id": 2,
            "error": {
              "code": -32602
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 3,
            "method": "session.list",
            "params": {
              "projectRoot": null
            }
          },
          "expect": {
            "id": 3,
            "error": {
              "code": -32602
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 4,
            "method": "session.attach",
            "params": {
              "sessionId": "x",
              "after": -1
            }
          },
          "expect": {
            "id": 4,
            "error": {
              "code": -32602
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 5,
            "method": "session.attach",
            "params": {
              "sessionId": "x",
              "after": 1.5
            }
          },
          "expect": {
            "id": 5,
            "error": {
              "code": -32602
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 6,
            "method": "session.create",
            "params": {
              "sessionId": "has space",
              "spec": {
                "cwd": "/nonexistent"
              }
            }
          },
          "expect": {
            "id": 6,
            "error": {
              "code": -32602
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 7,
            "method": "session.prompt",
            "params": {
              "sessionId": "x",
              "clientMessageId": "m",
              "content": "text"
            }
          },
          "expect": {
            "id": 7,
            "error": {
              "code": -32602
            }
          }
        },
        {
          "send": {
            "jsonrpc": "2.0",
            "id": 8,
            "method": "extension.register",
            "params": {}
          },
          "expect": {
            "id": 8,
            "error": {
              "code": -32602
            }
          }
        }
      ]
    },
    {
