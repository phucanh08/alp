{
  "name": "@anhlp/alp-protocol",
  "version": "0.0.1-beta.5",
  "type": "module",
  "description": "ALP protocol module",
  "files": [
    "src",
    "dist",
    "schema",
    "fixtures",
    "conformance",
    "NOTICE"
  ],
  "exports": {
    "./connection": {
      "alp-source": {
        "types": "./src/connection.ts",
        "default": "./src/connection.ts"
      },
      "types": "./dist/connection.d.ts",
      "default": "./dist/connection.js"
    },
    "./dto": {
      "alp-source": {
        "types": "./src/dto.ts",
        "default": "./src/dto.ts"
      },
      "types": "./dist/dto.d.ts",
      "default": "./dist/dto.js"
    },
    "./events": {
      "alp-source": {
        "types": "./src/events.ts",
        "default": "./src/events.ts"
      },
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./index": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./src/public.js"
    },
    ".": {
      "alp-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./src/public.js"
    },
    "./wire": {
      "alp-source": {
        "types": "./src/wire.js",
        "default": "./src/wire.js"
      },
      "types": "./dist/wire.d.ts",
      "default": "./src/wire.js"
    },
    "./contract": {
      "alp-source": {
        "types": "./src/contract.js",
        "default": "./src/contract.js"
      },
      "types": "./dist/contract.d.ts",
      "default": "./src/contract.js"
    },
    "./schema": {
      "default": "./schema/ipc-v1.json"
    },
    "./schema/methods": {
      "default": "./schema/methods-v1.json"
    },
    "./conformance": {
      "types": "./conformance/run.d.mts",
      "default": "./conformance/run.mjs"
    },
    "./session": {
      "alp-source": {
        "types": "./src/session.ts",
        "default": "./src/session.ts"
      },
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./rpc": {
      "alp-source": {
        "types": "./src/rpc.ts",
        "default": "./src/rpc.ts"
      },
      "types": "./dist/rpc.d.ts",
      "default": "./dist/rpc.js"
    },
    "./fixtures/v1/cases.json": {
      "default": "./fixtures/v1/cases.json"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {},
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs protocol",
    "test": "node ../../scripts/test-package.mjs protocol",
    "prepack": "npm run build",
    "generate": "node scripts/generate.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucanh08/alp.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/phucanh08/alp/tree/main/packages/protocol#readme",
  "bugs": {
    "url": "https://github.com/phucanh08/alp/issues"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
