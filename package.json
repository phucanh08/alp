{
  "name": "@anhlp/alp",
  "version": "0.10.0",
  "description": "ALP command line and alpd, the per-user daemon that runs filesystem-defined Codex and Claude Code agent teams",
  "type": "module",
  "files": [
    "packages/cli/dist",
    "packages/core/dist",
    "packages/client/dist",
    "dist/alpd.js",
    "dist/acp.js",
    "templates",
    "README.md",
    "docs/modular-monorepo.md"
  ],
  "bin": {
    "alp": "packages/cli/dist/cli.js"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:all": "node scripts/test.mjs all",
    "check": "tsc -p tsconfig.paseo.json && tsc -p tsconfig.client.json",
    "build": "node scripts/build-workspace.mjs cli && node scripts/build-core.mjs",
    "test:e2e:workflow": "node test/e2e/workflow-e2e.mjs pho && node test/e2e/workflow-e2e.mjs cafe",
    "test:e2e:mailbox": "node test/e2e/mailbox-e2e.mjs ask && node test/e2e/mailbox-e2e.mjs wake && node test/e2e/mailbox-e2e.mjs steer",
    "test:e2e:team": "node test/e2e/team-e2e.mjs",
    "test:e2e:claude": "node test/e2e/claude-e2e.mjs",
    "test:e2e:claude-runtime": "node test/e2e/claude-runtime-e2e.mjs",
    "test:e2e:paseo": "node test/e2e/paseo-e2e.mjs",
    "test:e2e:alpd": "node scripts/build-core.mjs && node test/e2e/alpd-e2e.mjs",
    "test:e2e:detach": "node test/e2e/viewer-detach-e2e.mjs",
    "test:e2e:persistence": "node scripts/build-core.mjs && node test/e2e/persistence-e2e.mjs",
    "test:e2e:import": "node test/e2e/import-e2e.mjs",
    "test:e2e:worktree": "node scripts/build-core.mjs && node test/e2e/worktree-e2e.mjs",
    "test:e2e:human": "node test/e2e/human-e2e.mjs cli && node test/e2e/human-e2e.mjs paseo",
    "test:e2e:board": "node scripts/build-core.mjs && node test/e2e/board-e2e.mjs",
    "prepack": "npm run build",
    "build:web": "node scripts/build-paseo-web.mjs",
    "build:packages": "npm run build --workspaces --if-present",
    "test:packages": "npm run test --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "release:check": "npm run check:boundaries && npm run check && npm test && npm run build:packages && npm run release:pack-check",
    "version:package": "node scripts/version-package.mjs",
    "release:pack-check": "node scripts/pack-check.mjs",
    "release:tarball-check": "node scripts/tarball-consumer.mjs",
    "test:packages:smoke": "node scripts/package-smoke.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:core": "node scripts/validate.mjs core",
    "validate:paseo": "node scripts/validate.mjs paseo",
    "validate:packages": "node scripts/validate.mjs packages",
    "check:core": "tsc -p tsconfig.core.json",
    "test:core:standalone": "node scripts/core-standalone-smoke.mjs",
    "build:paseo": "node scripts/build-workspace.mjs paseo"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1",
    "@types/ws": "^8.18.2",
    "ajv": "8.17.1",
    "esbuild": "0.25.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "ws": "^8.22.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@anhlp/alp-client": "0.10.0",
    "@anhlp/alp-core": "0.10.0",
    "@anhlp/alp-protocol": "0.10.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "smol-toml": "1.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucanh08/alp-paseo.git"
  },
  "homepage": "https://github.com/phucanh08/alp-paseo#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "packages/protocol",
    "packages/core",
    "packages/runtime",
    "packages/client",
    "packages/daemon",
    "packages/cli",
    "apps/tui",
    "integrations/paseo"
  ]
}
