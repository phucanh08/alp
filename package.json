{
  "name": "alp-monorepo",
  "private": true,
  "version": "0.0.1-beta.14",
  "description": "ALP monorepo (private): the npm packages are its pnpm workspaces (pnpm-workspace.yaml) and npm/alp, the @anhlp/alp wrapper",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "bin": {
    "alp": "packages/cli/dist/cli.js"
  },
  "scripts": {
    "test": "node scripts/test.ts",
    "test:unit": "node scripts/test.ts unit",
    "test:integration": "node scripts/test.ts integration",
    "test:e2e": "node scripts/test.ts e2e",
    "test:all": "node scripts/test.ts all",
    "check": "tsc -p tsconfig.paseo.json && tsc -p tsconfig.client.json && pnpm run check:scripts && pnpm run check:test",
    "check:scripts": "tsc -p scripts/tsconfig.json",
    "check:test": "tsc -p test/tsconfig.json",
    "build": "node scripts/build-workspace.ts cli && node scripts/build-core.ts",
    "test:e2e:workflow": "node test/e2e/workflow-e2e.mjs pho && node test/e2e/workflow-e2e.mjs cafe",
    "test:e2e:mailbox": "node test/e2e/mailbox-e2e.mjs ask && node test/e2e/mailbox-e2e.mjs wake && node test/e2e/mailbox-e2e.mjs steer",
    "test:e2e:team": "node test/e2e/team-e2e.mjs",
    "test:e2e:claude": "node test/e2e/claude-e2e.mjs",
    "test:e2e:claude-runtime": "node test/e2e/claude-runtime-e2e.mjs",
    "test:e2e:paseo": "node test/e2e/paseo-e2e.mjs",
    "test:e2e:paseo-remote": "node test/e2e/paseo-remote-e2e.mjs",
    "test:e2e:alpd": "node scripts/build-workspace.ts cli && node scripts/build-core.ts && node test/e2e/alpd-e2e.mjs",
    "test:e2e:detach": "node test/e2e/viewer-detach-e2e.mjs",
    "test:e2e:persistence": "node scripts/build-workspace.ts cli && node scripts/build-core.ts && node test/e2e/persistence-e2e.mjs",
    "test:e2e:import": "node scripts/build-workspace.ts cli && node test/e2e/import-e2e.mjs",
    "test:e2e:worktree": "node scripts/build-workspace.ts cli && node scripts/build-core.ts && node test/e2e/worktree-e2e.mjs",
    "test:e2e:human": "node scripts/build-workspace.ts cli && node test/e2e/human-e2e.mjs cli && node test/e2e/human-e2e.mjs paseo",
    "test:e2e:board": "node scripts/build-workspace.ts cli && node scripts/build-core.ts && node test/e2e/board-e2e.mjs",
    "prepack": "pnpm run build",
    "build:packages": "node scripts/run-workspaces.ts build",
    "test:packages": "node scripts/run-workspaces.ts test",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "release:check": "pnpm run check:boundaries && pnpm run check && pnpm test && pnpm run build:packages && pnpm run release:pack-check",
    "version:package": "node scripts/version-package.ts",
    "release:pack-check": "node scripts/pack-check.ts",
    "check:terminal-native": "node scripts/terminal-native-assets.ts --require-matrix",
    "release:tarball-check": "node scripts/tarball-consumer.ts",
    "release:check-version": "node scripts/release-check.ts",
    "release:pack": "node scripts/release-pack.ts",
    "release:verify": "node scripts/release-verify.ts",
    "release:consumer": "node scripts/release-consumer.ts",
    "release:gate": "node scripts/release-gate.ts",
    "test:packages:smoke": "node scripts/package-smoke.ts",
    "test:gateway:smoke": "node scripts/gateway-smoke.ts",
    "validate": "node scripts/validate.ts",
    "validate:core": "node scripts/validate.ts core",
    "validate:paseo": "node scripts/validate.ts paseo",
    "validate:packages": "node scripts/validate.ts packages",
    "check:core": "tsc -p tsconfig.core.json",
    "test:core:standalone": "node scripts/core-standalone-smoke.ts",
    "build:paseo": "node scripts/build-workspace.ts paseo",
    "dev:alp-web": "pnpm --filter @anhlp/alp-web run dev",
    "build:alp-web": "pnpm --filter @anhlp/alp-web run build",
    "build:alp-web:e2e-deps": "node scripts/build-workspace.ts cli && node scripts/build-workspace.ts gateway && node scripts/build-workspace.ts daemon",
    "typecheck:alp-web": "pnpm --filter @anhlp/alp-web run typecheck",
    "test:alp-web": "pnpm --filter @anhlp/alp-web test",
    "test:alp-web:e2e": "pnpm --filter @anhlp/alp-web run test:e2e",
    "validate:web": "node scripts/validate.ts web",
    "check:teardown-order": "node scripts/check-teardown-order.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@anhlp/alp-cli": "0.0.1-beta.14",
    "@anhlp/alp-daemon": "0.0.1-beta.14",
    "@anhlp/alp-gateway": "0.0.1-beta.14",
    "@anhlp/alp-runtime": "0.0.1-beta.14",
    "@anhlp/alp-tui": "0.0.1-beta.14",
    "@anhlp/alp-web": "0.0.1-beta.14",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1",
    "@types/ws": "^8.18.2",
    "ajv": "8.20.0",
    "camelcase": "5.3.1",
    "ci-info": "3.9.0",
    "commander": "12.1.0",
    "content-type": "1.0.5",
    "esbuild": "0.25.12",
    "fdir": "6.5.0",
    "hermes-estree": "0.29.1",
    "hermes-parser": "0.29.1",
    "picomatch": "2.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "semver": "7.8.5",
    "typescript": "5.9.3",
    "ws": "^8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@anhlp/alp-client": "0.0.1-beta.14",
    "@anhlp/alp-core": "0.0.1-beta.14",
    "@anhlp/alp-protocol": "0.0.1-beta.14",
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "smol-toml": "1.9.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucanh08/alp.git"
  },
  "homepage": "https://github.com/phucanh08/alp#readme",
  "bugs": {
    "url": "https://github.com/phucanh08/alp/issues"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15"
  }
}
