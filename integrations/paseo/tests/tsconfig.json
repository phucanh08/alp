{
  // Type-checks this workspace's tests strictly, with the options of test/tsconfig.json
  // (Node >= 22.18 runs them directly by stripping types). The tests import the build output
  // (../server/dist/*.js) as they run; rootDirs types those imports against the server/*.ts they are built
  // from, so the check needs no build. Run: pnpm run check:test
  "extends": "../../../test/tsconfig.json",
  "compilerOptions": {
    "rootDirs": ["../server", "../server/dist"]
  },
  "include": ["**/*.ts", "../server/alp-templates.d.ts"],
  // Data the tests copy or read, not code checked here.
  "exclude": ["fixtures/**"]
}
