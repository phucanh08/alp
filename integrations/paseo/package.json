{
  "name": "@anhlp/alp-paseo",
  "version": "0.0.1-beta.3",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.server.ts",
    "index.client.tsx",
    "client",
    "shared",
    "server/dist",
    "NOTICE"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.4.3",
    "@anhlp/alp-protocol": "0.0.1-beta.3",
    "@anhlp/alp-core": "0.0.1-beta.3",
    "@anhlp/alp-runtime": "0.0.1-beta.3",
    "@anhlp/alp-daemon": "0.0.1-beta.3",
    "@anhlp/alp-client": "0.0.1-beta.3",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@getpaseo/plugin": ">=0.11.1 <1.0.0",
    "react": ">=19 <20",
    "react-native": ">=0.81 <0.82",
    "@getpaseo/client": ">=0.11.1 <1.0.0",
    "@getpaseo/protocol": ">=0.11.1 <1.0.0",
    "@getpaseo/relay": ">=0.11.1 <1.0.0",
    "ws": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "description": "Filesystem-defined ALP agents with the Phở and Cafe profiles and a Tasks panel for Paseo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phucanh08/alp.git",
    "directory": "integrations/paseo"
  },
  "homepage": "https://github.com/phucanh08/alp/tree/main/integrations/paseo#readme",
  "bugs": {
    "url": "https://github.com/phucanh08/alp/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "scripts": {
    "build": "node ../../scripts/build-workspace.mjs paseo",
    "test": "node ../../scripts/test-package.mjs paseo",
    "prepack": "npm run build && node ../../scripts/check-web-app.mjs"
  },
  "bin": {
    "alp-paseo-integration": "server/dist/main.js",
    "alp-web-integration": "server/dist/main.js"
  },
  "exports": {
    ".": {
      "default": "./server/dist/index.js"
    },
    "./main": {
      "default": "./server/dist/main.js"
    },
    "./web": {
      "default": "./server/dist/web.js"
    },
    "./remote": {
      "default": "./server/dist/remote/index.js"
    },
    "./paseo/*": {
      "default": "./server/dist/paseo/*.js"
    },
    "./panel/*": {
      "default": "./server/dist/panel/*.js"
    }
  },
  "devDependencies": {
    "@getpaseo/client": "0.12.0",
    "@getpaseo/plugin": "0.12.0",
    "@getpaseo/protocol": "0.12.0",
    "@getpaseo/relay": "0.12.0",
    "esbuild": "0.25.12",
    "react-dom": "19.1.0"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.15"
  }
}
