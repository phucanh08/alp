{
  "label": "Research",
  "description": "Hai cố vấn chỉ đọc cho điều phối viên: librarian đọc source và lịch sử git của repo công khai bên ngoài (clone vào ~/.alp-librarian-cache), scout tìm code trong workspace; kèm hai team biến thể Phở + Research và Cafe + Research. Phở và Cafe mặc định không đổi.",
  "agents": [
    "librarian",
    "scout"
  ],
  "teams": [
    "pho-research",
    "cafe-research"
  ],
  "permissions": {
    "librarian": {
      "base": "read-only",
      "allow": [
        "Bash(@git-clone-public ~/.alp-librarian-cache)",
        "Bash(@git-read ~/.alp-librarian-cache)",
        "WebFetch(domain:github.com)",
        "WebFetch(domain:raw.githubusercontent.com)",
        "WebFetch(domain:gitlab.com)"
      ],
      "ask": [
        "Bash(git clone:*)",
        "Bash(git fetch:*)",
        "Bash(git -C:*)",
        "Bash(gh repo clone:*)"
      ],
      "deny": [
        "Bash(@git-unsafe)",
        "Bash(git push:*)",
        "Bash(rm:*)"
      ]
    },
    "scout": "read-only"
  }
}
